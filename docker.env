# Конфигурация для Docker Compose
# Скопируйте этот файл в .env и заполните ваши настройки

# AI Gateway настройки
AI_GATEWAY_URL = ""
AI_GATEWAY_API_KEY = ""

# База данных (настройки для Docker Compose)
DB_CONNECTION_STRING=dbname=PurchaseService user=postgres password=postgres host=postgres port=5432

# Дополнительные настройки приложения
SCHEMA_NAME=public
LLM_MODEL=qwen3-coder
AI_TIMEOUT=60
